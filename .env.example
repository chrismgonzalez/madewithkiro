# API Configuration
# Required: Base URL for the backend API
VITE_API_BASE_URL=https://api.example.com

# AWS Cognito Configuration
# Required: Cognito User Pool ID (get from CloudFormation outputs after SAM deployment)
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# Required: Cognito App Client ID (get from CloudFormation outputs after SAM deployment)
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Required: AWS Region for Cognito
VITE_COGNITO_REGION=us-east-1

# Required: Cognito Domain (without https://, get from Cognito console or CloudFormation)
# Format: your-domain.auth.region.amazoncognito.com
VITE_COGNITO_DOMAIN=your-app.auth.us-east-1.amazoncognito.com

# AWS Amplify Configuration (aliases for Amplify compatibility)
# Required: User Pool ID (same as VITE_COGNITO_USER_POOL_ID)
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX

# Required: User Pool Client ID (same as VITE_COGNITO_CLIENT_ID)
VITE_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Required: Cognito Identity Pool ID (get from CloudFormation outputs after SAM deployment)
VITE_IDENTITY_POOL_ID=us-east-1:XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# Required: AWS Region (same as VITE_COGNITO_REGION)
VITE_AWS_REGION=us-east-1

# OAuth Redirect URLs
# Required: OAuth callback URL after successful authentication
# Development: http://localhost:5173/auth/callback
# Production: https://yourdomain.com/auth/callback
VITE_OAUTH_REDIRECT_SIGN_IN=http://localhost:5173/auth/callback

# Required: OAuth redirect URL after sign out
# Development: http://localhost:5173/
# Production: https://yourdomain.com/
VITE_OAUTH_REDIRECT_SIGN_OUT=http://localhost:5173/

# Test User Configuration
# Required: Test user ID for development (used when authentication is not yet implemented)
VITE_TEST_USER_ID=test-user-001

# Environment
# Required: Application environment (development or production)
VITE_ENVIRONMENT=development
