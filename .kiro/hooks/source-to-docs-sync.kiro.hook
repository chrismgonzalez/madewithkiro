{
  "enabled": true,
  "name": "Source to Docs Sync",
  "description": "Monitors changes to Python source files (*.py), TypeScript/JavaScript files (*.ts, *.tsx, *.js, *.jsx), configuration files (template.yaml, samconfig.toml, package.json, pyproject.toml), and other relevant source patterns. When these files change, asks the agent to review and update documentation in README.md or the /docs folder to reflect the changes.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file has been modified. Review the changes and determine if documentation needs to be updated. Check if the changes affect:\n\n1. API endpoints or interfaces\n2. Configuration options or environment variables\n3. Architecture or data models\n4. Setup or deployment procedures\n5. Component props or usage patterns\n6. New features or functionality\n\nIf documentation updates are needed, update the relevant files in /docs or README.md to reflect the changes. Focus on:\n- Keeping examples accurate\n- Updating setup instructions if needed\n- Documenting new features or breaking changes\n- Ensuring architecture diagrams match implementation\n\nIf no documentation changes are needed, briefly explain why."
  }
}